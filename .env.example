# ---------------------------------------------------------------------------
# AgriMall World — environment configuration (§30)
#
#   cp .env.example .env    then fill in the values below.
#
# NOTHING in this project hardcodes a secret. Anything missing that is
# genuinely required makes the app fail loudly on boot, rather than
# half-working in production.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (REQUIRED) ---------------------------------------------------
# PostgreSQL. Create the database first:  createdb agrimall
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrimall?schema=public"

# --- Sessions (REQUIRED) ---------------------------------------------------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-this-with-a-64-character-random-hex-string-before-deploying"
SESSION_TTL_HOURS=168

# --- Payments --------------------------------------------------------------
# The integration code is complete; only these credentials are pending.
# Leave PAYMENT_PROVIDER=NONE to run in Cash-on-Delivery-only mode — the app
# will say so plainly rather than faking a successful card payment.
#
#   RAZORPAY | STRIPE | NONE
PAYMENT_PROVIDER=NONE

# Razorpay (dashboard → Settings → API Keys, and → Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Webhook URL to register:  https://your-domain/api/payments/webhook/razorpay
# Events to subscribe to:   payment.captured, payment.failed, order.paid

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook URL:  https://your-domain/api/payments/webhook/stripe
# Events:       payment_intent.succeeded, payment_intent.payment_failed

# --- File storage ----------------------------------------------------------
# LOCAL writes product images to ./public/uploads and KYC documents to
# ./storage/private (outside the web root). Good for development and a single
# server. Use S3 in production, especially on serverless hosts where the local
# filesystem is not persistent.
#
#   LOCAL | S3
STORAGE_DRIVER=LOCAL
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Email -----------------------------------------------------------------
# LOG prints messages to the server log instead of sending them — nothing is
# silently swallowed. Switch to SMTP or RESEND to deliver for real.
#
#   LOG | SMTP | RESEND
EMAIL_DRIVER=LOG
EMAIL_FROM="AgriMall World <no-reply@agrimall.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
# SMTP needs one extra package:  npm install nodemailer

# --- Business rules --------------------------------------------------------
# These are boot defaults. An admin can change them at runtime under
# Settings, and the database value wins when present.

# Platform commission %, used when neither the seller nor the category has
# its own rate.
DEFAULT_COMMISSION_RATE=10

# Shipping, in PAISE (1 rupee = 100 paise). Charged PER SELLER, because each
# seller ships its own parcel.
SHIPPING_FLAT_FEE_PAISE=14900
SHIPPING_FREE_ABOVE_PAISE=200000

# How long checkout holds stock while the customer pays.
RESERVATION_TTL_MINUTES=30

# Days after delivery a customer may return a parcel. Payouts are held for
# this long, so a refund never chases money already sent to a seller.
RETURN_WINDOW_DAYS=7

# --- Scheduled jobs --------------------------------------------------------
# Protects /api/cron/*. Generate like SESSION_SECRET.
CRON_SECRET="replace-this-too"
